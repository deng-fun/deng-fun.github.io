[project]
sub_id = "aa48c217"
name = "astro-koharu"
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/coze-preview-build.sh"]
run = ["bash", "scripts/coze-preview-run.sh"]

[deploy]
build = ["pnpm", "run", "build"]
run = ["pnpm", "preview"]

[subprojects]
path = ["."]
